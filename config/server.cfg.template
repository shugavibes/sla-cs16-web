// Configuración del servidor de CS. start.sh genera config/server.cfg a partir de
// este archivo cada vez que arranca: cambiá esta plantilla, no server.cfg.
// Los valores entre llaves dobles los completa start.sh. El nombre (hostname) lo pone
// cada sala, según config/salas.conf.
// Basada en la configuración de CSweb (MIT).

hostname "{{NOMBRE}}"
rcon_password "{{RCON}}"
sv_password "{{CONTRASENA}}"
sv_lan 1
sv_cheats {{CHEATS}}
pausable 0
sv_aim 0
sv_allowupload 0
sv_allowdownload 1
allow_spectators 1
// si un jugador se corta (o cerró la pestaña), su lugar se libera al minuto
sv_timeout 60

// Red
sys_ticrate 128
sv_maxrate 100000
sv_minrate 25000
sv_maxupdaterate 101
sv_minupdaterate 30

// Reglas de juego
mapcyclefile mapcycle.txt
mp_timelimit 0
mp_roundtime 3
mp_freezetime 2
mp_buytime 9
mp_c4timer 35
mp_startmoney 16000
mp_friendlyfire 0
mp_autoteambalance 1
mp_limitteams 2
mp_autokick 0
mp_flashlight 1
mp_footsteps 1
mp_consistency 0
// Como en el CS de siempre: si entrás en los primeros 20 segundos de la ronda aparecés
// jugando; si no, mirás la partida y entrás en la próxima ronda.
mp_roundrespawn_time 20

// Bots YaPB (la cantidad y la dificultad salen de .env: BOTS y BOTS_DIFICULTAD)
// Los bots esperan a que entre alguien: con la sala vacía no gastan CPU al servidor.
yb_join_after_player 1
yb_quota_mode "normal"

exec listip.cfg
exec banned.cfg
